import re

products = [
    "Apple iPhone 15",
    "Apple MacBook Air",
    "Samsung Galaxy S24",
    "Samsung Galaxy Buds",
    "Sony Wireless Headphones",
    "Sony Bravia TV",
    "Dell Laptop",
    "HP Laptop",
    "OnePlus Smartphone",
    "Logitech Wireless Mouse",
    "Apple iPad",
    "Samsung Smart Watch"
]

def search_products(keyword, search_type):
    keyword = re.escape(keyword)

    if search_type == "exact":
        pattern = r"^" + keyword + r"$"
    elif search_type == "prefix":
        pattern = r"^" + keyword
    elif search_type == "suffix":
        pattern = keyword + r"$"
    elif search_type == "partial":
        pattern = keyword
    else:
        print("Invalid search type!")
        return []

    return [
        p for p in products
        if re.search(pattern, p, re.I)
    ]

def generate_report(keyword, search_type):
    results = search_products(keyword, search_type)

    print("\n" + "=" * 55)
    print("Search Type:", search_type.upper())
    print("Search Keyword:", keyword)
    print("-" * 55)

    if results:
        print("Matching Products:")
        for p in results:
            print("-", p)
    else:
        print("No matching products found.")

    print("Total Matching Products:", len(results))

    return {
        "Keyword": keyword,
        "Search Type": search_type,
        "Total Matches": len(results),
        "Matching Products": results
    }

search_report = []

search_report.append(
    generate_report("Apple iPhone 15", "exact")
)
search_report.append(
    generate_report("Samsung", "prefix")
)
search_report.append(
    generate_report("Laptop", "suffix")
)
search_report.append(
    generate_report("Wireless", "partial")
)
search_report.append(
    generate_report("apple", "partial")
)

print("\nFINAL PRODUCT SEARCH SUMMARY")

for report in search_report:
    print(
        f"Keyword: {report['Keyword']:<20} | "
        f"Type: {report['Search Type']:<7} | "
        f"Matches: {report['Total Matches']}"
    )
