import re
import json
resumes = [
    """Name: Rahul Sharma
Email: rahul.sharma@gmail.com
Mobile: +91 9876543210
Skills: Python, SQL, Machine Learning, NLP
Experience: 3 years""",
    """Name: Priya Reddy
Email: priya.reddy@yahoo.com
Mobile: 9123456789
Skills: Java, SQL, NLP
Experience: 4 years""",
    """Name: Arjun Kumar
Email: arjun.kumar@outlook.com
Mobile: 9988776655
Skills: Python, Java, SQL
Experience: 1 year""",
    """Name: Sneha Patel
Email: sneha.patel@gmail.com
Mobile: +91-9876501234
Skills: Python, Java, Machine Learning
Experience: 2 years"""
]
name_pattern = r"Name\s*:\s*([A-Za-z]+(?:\s+[A-Za-z]+)*)"
email_pattern = r"\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b"
mobile_pattern = r"(?<!\d)(?:\+91[-\s]?)?[6-9]\d{9}(?!\d)"
experience_pattern = r"Experience\s*:\s*(\d+(?:\.\d+)?)\s*(?:years?|yrs?)\b"
technical_skills = [
    "Python", "Java", "SQL", "Machine Learning", "NLP"
]
def extract_resume_info(resume):
    name = re.search(name_pattern, resume, re.I)
    email = re.search(email_pattern, resume)
    mobile = re.search(mobile_pattern, resume)
    exp = re.search(experience_pattern, resume, re.I)
    skills = []
    for skill in technical_skills:
        pattern = r"(?<!\w)" + re.escape(skill) + r"(?!\w)"
        if re.search(pattern, resume, re.I):
            skills.append(skill)
    experience = float(exp.group(1)) if exp else 0
    eligible = experience >= 2 and "Python" in skills
    return {
        "Name": name.group(1) if name else "Not found",
        "Email": email.group(0) if email else "Not found",
        "Mobile": mobile.group(0) if mobile else "Not found",
        "Technical Skills": skills,
        "Experience (Years)": experience,
        "Eligible": "Yes" if eligible else "No"
    }
candidate_profiles = []
for i, resume in enumerate(resumes, 1):
    profile = extract_resume_info(resume)
    profile["Candidate ID"] = i
    candidate_profiles.append(profile)
print("=" * 65)
print("RESUME INFORMATION EXTRACTION SYSTEM")
print("=" * 65)
for profile in candidate_profiles:
    print("\nCandidate ID:", profile["Candidate ID"])
    print(json.dumps(profile, indent=4))
eligible_candidates = [
    c for c in candidate_profiles if c["Eligible"] == "Yes"
]
print("\nELIGIBLE CANDIDATES")
for c in eligible_candidates:
    print(
        f"Name: {c['Name']} | Experience: "
        f"{c['Experience (Years)']} years | "
        f"Skills: {', '.join(c['Technical Skills'])}"
    )
print("\nTotal resumes:", len(candidate_profiles))
print("Eligible candidates:", len(eligible_candidates))
